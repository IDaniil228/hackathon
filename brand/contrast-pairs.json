{
  "$description": "Пары \"цвет переднего плана / фон\", которые реально встречаются в brand/dist/base.css. Имена - ключи theme в tokens.json; каждая пара проверяется в обеих темах. kind: text - обычный текст (4.5:1), large-text - крупный текст (3:1), ui - граница или индикатор элемента управления (3:1, WCAG 1.4.11)",
  "pairs": [
    { "fg": "text", "bg": "bg", "kind": "text", "where": "body, заголовки на фоне страницы" },
    { "fg": "text-muted", "bg": "bg", "kind": "text", "where": ".fsp-muted, .fsp-overline, .fsp-hint на фоне страницы" },
    { "fg": "link", "bg": "bg", "kind": "text", "where": "a на фоне страницы" },
    { "fg": "link-hover", "bg": "bg", "kind": "text", "where": "a:hover на фоне страницы" },
    { "fg": "link-hover", "bg": "surface", "kind": "text", "where": "a:hover в карточке" },
    { "fg": "danger-text", "bg": "bg", "kind": "text", "where": ".fsp-error-text на фоне страницы" },
    { "fg": "text", "bg": "surface", "kind": "text", "where": ".fsp-card, .fsp-input, .fsp-table td, .fsp-topbar, .fsp-sidebar, .fsp-btn--secondary" },
    { "fg": "text-muted", "bg": "surface", "kind": "text", "where": ".fsp-hint, плейсхолдер .fsp-input, .fsp-muted в карточке" },
    { "fg": "link", "bg": "surface", "kind": "text", "where": "a в карточке, .fsp-btn--ghost" },
    { "fg": "danger-text", "bg": "surface", "kind": "text", "where": ".fsp-error-text в карточке" },
    { "fg": "text", "bg": "surface-muted", "kind": "text", "where": "code, .fsp-tag, .fsp-alert--neutral" },
    { "fg": "text-muted", "bg": "surface-muted", "kind": "text", "where": ".fsp-table th, .fsp-badge--withdrawn, .fsp-badge--expired" },
    { "fg": "text", "bg": "surface-hover", "kind": "text", "where": ".fsp-btn--secondary:hover, .fsp-table tr:hover, .fsp-nav__link:hover" },
    { "fg": "link", "bg": "surface-hover", "kind": "text", "where": ".fsp-btn--ghost:hover" },
    { "fg": "text", "bg": "neutral-soft", "kind": "text", "where": ".fsp-badge--viewed, .fsp-btn--secondary:active" },
    { "fg": "link", "bg": "primary-soft", "kind": "text", "where": ".fsp-badge--sent, .fsp-nav__link[aria-current], .fsp-tag--verified, .fsp-btn--ghost:active" },
    { "fg": "text", "bg": "primary-soft", "kind": "text", "where": ".fsp-alert--info, .fsp-alert--success" },
    { "fg": "text", "bg": "selection", "kind": "text", "where": "::selection" },
    { "fg": "text-on-primary", "bg": "primary", "kind": "text", "where": ".fsp-btn--primary, .fsp-badge--accepted, .fsp-count" },
    { "fg": "text-on-primary", "bg": "primary-hover", "kind": "text", "where": ".fsp-btn--primary:hover" },
    { "fg": "text-on-primary", "bg": "primary-active", "kind": "text", "where": ".fsp-btn--primary:active" },
    { "fg": "text-on-primary", "bg": "danger", "kind": "text", "where": ".fsp-btn--danger" },
    { "fg": "text-on-primary", "bg": "danger-hover", "kind": "text", "where": ".fsp-btn--danger:hover, .fsp-btn--danger:active" },
    { "fg": "danger-text", "bg": "danger-soft", "kind": "text", "where": ".fsp-badge--declined, .fsp-alert--danger .fsp-alert__title" },
    { "fg": "text", "bg": "danger-soft", "kind": "text", "where": ".fsp-alert--danger" },
    { "fg": "border-strong", "bg": "surface", "kind": "ui", "where": "граница .fsp-input, .fsp-select, .fsp-switch" },
    { "fg": "border-strong", "bg": "bg", "kind": "ui", "where": "граница поля ввода прямо на фоне страницы" },
    { "fg": "danger-text", "bg": "surface", "kind": "ui", "where": "граница поля с aria-invalid" },
    { "fg": "focus", "bg": "surface", "kind": "ui", "where": ":focus-visible в карточке" },
    { "fg": "focus", "bg": "bg", "kind": "ui", "where": ":focus-visible на фоне страницы" },
    { "fg": "control", "bg": "surface", "kind": "ui", "where": "включённый .fsp-switch, отметка checkbox и radio" },
    { "fg": "control-knob", "bg": "control", "kind": "ui", "where": "ручка включённого .fsp-switch" },
    { "fg": "text-muted", "bg": "surface-muted", "kind": "ui", "where": "ручка выключенного .fsp-switch" }
  ]
}
