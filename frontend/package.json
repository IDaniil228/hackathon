{
  "name": "scepka",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1 --port 3000",
    "docs:pdf": "node scripts/export-docs.mjs",
    "screenshots": "playwright test --forbid-only --fail-on-flaky-tests --retries 0",
    "api:generate": "openapi-typescript ../docs/api/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "markdown-it": "^14.1.0",
    "mermaid": "^11.12.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@tanstack/react-query": "^5.90.0",
    "@uiw/react-codemirror": "^4.25.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "overrides": { "katex": "^0.18.2" },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "prettier": "^3.7.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "openapi-typescript": "^7.10.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.3"
  }
}
