{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "Bundler", "jsx": "react-jsx", "strict": true, "skipLibCheck": true,
    "allowImportingTsExtensions": true, "resolveJsonModule": true, "noEmit": true,
    "noUnusedLocals": true, "noUnusedParameters": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "tests", "vite.config.ts", "playwright.config.ts", "vitest.config.ts"]
}
