# Скопировать в .env перед первым запуском: cp .env.example .env
POSTGRES_DB=fsp
POSTGRES_USER=fsp
POSTGRES_PASSWORD=change_me_locally
POSTGRES_PORT=5432
API_PORT=8000
FRONTEND_PORT=3000
ADMINER_PORT=8081

# Для запуска вне контейнера (poetry run uvicorn ...) — хост localhost вместо postgres
DATABASE_URL=postgresql+psycopg://fsp:change_me_locally@localhost:5432/fsp

# UID/GID хозяина: от них работает контейнер api, чтобы созданные им
# файлы (ревизии alembic, бэкапы) не оказывались root-овскими
UID=1000
GID=1000

JWT_SECRET=
API_DB_PASSWORD=
TASKGEN_CLIENT_KEY=
MATCHER_CLIENT_KEY=
DEMO_AUTH_ALLOW_UNVERIFIED=false
DEMO_EMAIL_TOKENS=false
FSP_DEMO_ENABLED=false
ALLOW_PUBLIC_CONTACTS=false
COOKIE_SECURE=true
CORS_ORIGINS=["http://localhost:3000"]
FRONTEND_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=
RESUME_LLM_ENABLED=false
LLM__PROVIDERS__OLLAMA__BASE_URL=http://localhost:11434/v1
